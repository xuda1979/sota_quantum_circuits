   "generation": 1,
   "source": "def build(ctx):\n    a = ctx.alloc(4); ctx.reg(\"a\", a)\n    b = ctx.alloc(4); ctx.reg(\"b\", b)\n    c = ctx.alloc()                 # single carry ancilla, |0>\n\n    def maj(i):\n        # (a[i], b[i], c) -> (a^b, b^c, carry_out)\n        ctx.cx(b[i], a[i])\n        ctx.cx(c, b[i])\n        ctx.ccx(a[i], b[i], c)\n        ctx.cx(b[i], c)\n\n    def uma(i):\n        # (a^b, b^c, carry_out) -> (sum, b, carry_in)\n        ctx.ccx(a[i], b[i], c)\n        ctx.cx(b[i], c)\n        ctx.cx(c, b[i])\n        ctx.cx(c, a[i])\n\n    for i in range(4):           # forward: propagate carries LSB->MSB\n        maj(i)\n    for i in range(4 - 1, -1, -1):   # backward: uncompute carries MSB->LSB\n        uma(i)\n\n    ctx.free(c)\n",
   "notes": [
